# Copy to ".env". Only the backend URL goes here - NEVER put AI provider keys in the mobile app.
# Anything starting with EXPO_PUBLIC_ is bundled into the app and visible to users.
#
# Android emulator:        http://10.0.2.2:8000
# iOS simulator:           http://localhost:8000
# Physical phone (Wi-Fi):  http://<your PC's LAN IP>:8000   e.g. http://192.168.1.23:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
