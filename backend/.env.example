# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Configurable on purpose: model IDs change over time. Check the current list at
# https://ai.google.dev/gemini-api/docs/models and change this if the call fails with "model not found".
GEMINI_MODEL=gemini-2.5-flash
# Optional extra Gemini models the router may choose from (comma-separated). Each must be a real, current model ID.
GEMINI_MODELS=

# Reserved for the OpenAI provider (not implemented yet in the MVP)
OPENAI_API_KEY=
OPENAI_MODEL=

# Limits
PROVIDER_TIMEOUT_SECONDS=30
MAX_MESSAGE_CHARS=8000
MAX_MESSAGES=40
MAX_REQUEST_BYTES=200000

# Privacy engine (Presidio runs locally; prompts are never sent anywhere to be scanned).
# Actions: allow | warn | redact | block. Override defaults with JSON, e.g. {"EMAIL_ADDRESS":"warn","PERSON":"allow"}
# See app/privacy/policy.py for default actions and category names.
PRIVACY_POLICY={}
PRIVACY_DEFAULT_ACTION=warn
PRIVACY_MIN_SCORE=0.4

# Documents / RAG. PostgreSQL with the pgvector extension, e.g. postgresql://user:password@localhost:5432/agentvision
# Leave empty to disable documents (endpoints return documents_database_not_configured). Then run: python -m app.db.migrate
DATABASE_URL=
# Embeddings use GEMINI_API_KEY above (server-side only).
EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector column created by the FIRST migration (128-2000). Changing it later needs a new migration + re-index.
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
# Upload and extraction limits.
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_PAGES=300
DOCUMENT_MAX_EXTRACTED_CHARS=300000
DOCUMENT_MIN_TEXT_CHARS=20
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=30
# Chunking (characters). Overlap must be smaller than the chunk size.
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
MAX_CHUNKS_PER_DOCUMENT=500
# Retrieval: passages per answer, minimum cosine similarity (-1..1, not calibrated; tune for your data), evidence budget.
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.45
RAG_MAX_CONTEXT_CHARS=8000

# Research (web search with citations). Get a key at https://app.tavily.com . Without it, /api/research returns
# research_provider_not_configured. Only the approved research question is ever sent to Tavily.
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=15
# Upper bound on sources per request (1-10); the app may ask for fewer.
RESEARCH_MAX_RESULTS=5
# Evidence given to the model: per-source and total character budgets.
RESEARCH_MAX_SOURCE_CHARS=1500
RESEARCH_MAX_TOTAL_SOURCE_CHARS=8000
# Longest research question accepted (characters, 20-400).
RESEARCH_MAX_QUERY_CHARS=400
# basic (1 Tavily credit) | advanced (2 credits). The app can choose per request.
RESEARCH_DEFAULT_DEPTH=basic

# Response privacy: what happens when the AI's REPLY contains sensitive data. Separate from the input policy above.
# RESPONSE_PRIVACY_MODE:
#   policy (default) = built-in per-category table: API keys, private keys, passwords, cards, SSN, Aadhaar, passports
#                      are REDACTED; emails, phone numbers, IBAN, PAN are returned with a WARNING; names and IP
#                      addresses are ignored (too noisy in ordinary text).
#   allow | warn | redact | block = one action for every reported category (allow records findings only).
# If the reply cannot be scanned, redacted or verified it is withheld (fail closed). This is not configurable.
RESPONSE_PRIVACY_MODE=policy
# Per-category overrides (win over the mode). Actions: ignore | allow | warn | redact | block. Example:
# RESPONSE_PRIVACY_POLICY={"EMAIL_ADDRESS":"redact","API_KEY":"block"}
RESPONSE_PRIVACY_POLICY={}
# Action for detected categories not in the built-in table.
RESPONSE_PRIVACY_DEFAULT_ACTION=warn
# Replies longer than this are withheld because they are not scanned.
RESPONSE_PRIVACY_MAX_CHARS=200000

# Model router (all optional; the defaults behave like the earlier Gemini-only setup).
# Policy used when the app doesn't send one: balanced | cost | quality | latency | manual
ROUTER_DEFAULT_POLICY=balanced
# Which model handles which task type (quality/balanced policies). Keys: conversation, coding, summarization,
# reasoning, extraction, research, documents. Values must be models listed in GEMINI_MODEL / GEMINI_MODELS. Example:
# ROUTER_TASK_MODELS={"coding":"your-stronger-model-id","summarization":"your-cheaper-model-id"}
ROUTER_TASK_MODELS={}
# Prices YOU supply, USD per million tokens, from your provider's pricing page. Needed for the cost policy and for
# cheaper-only fallback. Nothing is built in; missing prices are treated as unknown. Example:
# MODEL_PROFILES={"your-model-id":{"input_cost_per_mtok":0.30,"output_cost_per_mtok":2.50}}
MODEL_PROFILES={}
# Comma-separated provider names the router may use (empty = all configured). Order = preference.
ROUTER_ALLOWED_PROVIDERS=
# Providers allowed when the user confirmed a privacy warning (empty = same as allowed).
ROUTER_SENSITIVE_PROVIDERS=
# Fallback after a failure: off | cheaper_or_equal (default; only to a model KNOWN to cost no more) | any_eligible
ROUTER_FALLBACK=cheaper_or_equal
ROUTER_MAX_FALLBACKS=1
# A model is taken out of rotation for ROUTER_COOLDOWN_SECONDS after this many consecutive failures
# (immediately for bad API key / unknown model).
ROUTER_FAILURE_THRESHOLD=3
ROUTER_COOLDOWN_SECONDS=60
# Successful calls needed before a model's latency is considered measured (latency policy).
ROUTER_MIN_LATENCY_SAMPLES=3
# No fallback attempt is started if it could push the request past this many seconds.
ROUTER_TOTAL_TIMEOUT_SECONDS=80

# Comma-separated allowed browser origins (only matters for Expo web). Native apps ignore CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=INFO
